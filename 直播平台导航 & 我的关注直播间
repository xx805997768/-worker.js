];
function showLives(arr){
  let ul = document.getElementById("liveList"); ul.innerHTML="";
  arr.forEach((item,idx)=>{
    let li = document.createElement("li");
    li.innerHTML = \`<a href="\${item.url}" target="_blank" rel="noopener noreferrer">\${item.name}</a>
      <button class="edit-btn" title="编辑" onclick="editLive(\${idx})">编辑</button>
      <button class="delete-btn" title="删除" onclick="deleteLive(\${idx})">删除</button>
      <button class="qr-btn" title="二维码" onclick="showQR('\${encodeURIComponent(item.name)}','\${encodeURIComponent(item.url)}')">📱</button>\`;
    ul.appendChild(li);
  });
}
function loadLives(){
  let arr=[];
  try{arr=JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]");}catch{arr=[];}
  if(!Array.isArray(arr)) arr=[];
  showLives(arr);
}
function addLive(){
  let name = document.getElementById("liveName").value.trim();
  let url  = document.getElementById("liveUrl").value.trim();
  if(!name || !url){ alert("请填写名称和链接！"); return; }
  if(!/^https?:\\/\\//.test(url)){ alert('链接必须以 http/https 开头！'); return;}
  let arr=[];
  try{arr=JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]");}catch{arr=[];}
  if(arr.some(x=>x.url===url)){ alert("该直播间已在列表中！"); return; }
  arr.push({name,url});
  localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
  showLives(arr);
  document.getElementById('liveName').value = "";
  document.getElementById('liveUrl').value = "";
}
function deleteLive(idx){
  let arr=[];
  try{arr=JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]");}catch{arr=[];}
  arr.splice(idx,1);
  localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
  showLives(arr);
}
function editLive(idx){
  let arr = [];
  try{arr=JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]");}catch{arr=[];}
  if(!arr[idx]) return;
  let old = arr[idx];
  let name = prompt("修改直播间名称：", old.name);
  if(name===null)return;
  name = name.trim();
  if(!name){ alert("名称不能为空"); return;}
  let url = prompt("修改直播间链接：", old.url);
  if(url===null)return;
  url = url.trim();
  if(!/^https?:\\/\\//.test(url)){ alert('链接必须以 http/https 开头！'); return;}
  arr[idx].name = name;
  arr[idx].url = url;
  localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
  showLives(arr);
}
function resetLives(){
  if(!confirm("确定要恢复为默认关注列表？此操作会丢失现有全部自定义！"))return;
  localStorage.setItem(STORAGE_KEY,JSON.stringify(DEFAULT_LIVES));
  showLives(DEFAULT_LIVES);
}
function exportLives(){
  let arr = [];
  try{arr=JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]");}catch{arr=[];}
  if(!arr.length){alert("暂无关注直播间！");return;}
  let txt = arr.map(x=>\`\${x.name} | \${x.url}\`).join('\\n');
  if(navigator.clipboard){
    navigator.clipboard.writeText(txt).then(()=>{
      alert("已复制关注名单到剪贴板，可以粘贴到任意地方！");
    },()=>{
      alert("复制失败");
    });
  }else{
    let area = document.createElement("textarea");
    area.value = txt;
    document.body.appendChild(area);
    area.select();
    try{document.execCommand("copy"); alert("已复制关注名单到剪贴板");}catch{alert("复制失败");}
    document.body.removeChild(area);
  }
}
function toggleImportArea() {
  let area = document.getElementById("importArea");
  if(area.style.display==="none"){ area.style.display="block"; }
  else{ area.style.display="none"; document.getElementById("importText").value=""; }
}
function importLives(){
  let txt = document.getElementById("importText").value;
  let lines = txt.split('\\n').map(l=>l.trim()).filter(l=>l);
  let arr = [];
  for(let l of lines){
    let parts = l.split('|');
    if(parts.length<2) continue;
    let name = parts[0].trim();
    let url = parts.slice(1).join("|").trim();
    if(!name || !/^https?:\\/\\//.test(url)) continue;
    arr.push({name,url});
  }
  if(!arr.length){alert("导入格式无效或内容为空"); return;}
  localStorage.setItem(STORAGE_KEY,JSON.stringify(arr));
  showLives(arr);
  document.getElementById("importText").value="";
  toggleImportArea();
  alert(\`共导入\${arr.length}个关注直播间！\`);
}
