(function(){
  const themeBtn = document.getElementById("themeToggle");
  const DARK_CLASS = "dark-theme";
  function setTheme(isDark){
    let body = document.body;
    if(isDark){
      body.classList.add(DARK_CLASS);
      themeBtn.textContent = "☀️ 日间模式";
    }else{
      body.classList.remove(DARK_CLASS);
      themeBtn.textContent = "🌙 夜间模式";
    }
    localStorage.setItem("ui_theme", isDark?"dark":"light");
  }
  function systemPrefersDark(){
    return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  }
  let cur = localStorage.getItem("ui_theme");
  if(cur==="dark" || (cur==null && systemPrefersDark())) setTheme(true);
  else setTheme(false);
  themeBtn.onclick = function(){
    setTheme(!document.body.classList.contains(DARK_CLASS));
  }
})();
(function(){
  const key = "visits_counter";
  const view = document.getElementById("visitCounter");
  function getTodayStr() {
    let d=new Date(),m=d.getMonth()+1; m=m<10?"0"+m:m;
    let day=d.getDate(); day=day<10?"0"+day:day;
    return d.getFullYear()+"-"+m+"-"+day;
  }
  function loadCounter(){
    let data = {};
    try{data=JSON.parse(localStorage.getItem(key)||"{}");}catch{data={};}
    let now = getTodayStr();
    if(!data.total) data.total=0;
    if(!data.daily) data.daily= {};
    if(!data.daily[now]) data.daily[now]=0;
    data.total++;
    data.daily[now]++;
    localStorage.setItem(key,JSON.stringify(data));
    view.innerHTML = \`你已访问本页 <span style="font-weight:600">\${data.total}</span> 次，今日 <span style="font-weight:600">\${data.daily[now]}</span> 次\`;
  }
  loadCounter();
})();
