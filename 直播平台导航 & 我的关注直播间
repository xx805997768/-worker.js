  let qr = document.getElementById("qrcode");
  qr.innerHTML = "";
  new QRCode(qr, {
    text: url,
    width: 145,
    height: 145,
    colorDark: "#2584ea",
    colorLight: "#fff",
    correctLevel: QRCode.CorrectLevel.H
  });
  document.getElementById("qrModal").style.display="block";
};
