(function(){
  function getVisitCount(){
    let v = localStorage.getItem("visits_counter");
    if(!v) return 0;
    try{v=JSON.parse(v);}catch{return 0;}
    return v.total||0;
  }
  function getLiveCount(){
    let arr = [];
    try{arr=JSON.parse(localStorage.getItem("my_lives_v2")||"[]");}catch{arr=[];}
    if(!Array.isArray(arr)) return 0;
    return arr.length;
  }
  function checkMedal(){
    let visit=getVisitCount(),live=getLiveCount(),medal="";
    if(visit>=1000) medal+="🎖超级常客<br><small>访问1000+次</small><br>";
    else if(visit>=500) medal+="🏅活跃常客<br><small>访问500+次</small><br>";
    else if(visit>=100) medal+="🥇普通常客<br><small>访问100+次</small><br>";
    if(live>=30) medal+="🏆全平台达人<br><small>关注30+直播间</small><br>";
    else if(live>=15) medal+="🥈热心关注者<br><small>关注15+直播间</small><br>";
    else if(live>=5) medal+="🥉新手关注者<br><small>关注5+直播间</small><br>";
    if(medal){
      let panel = document.getElementById("medalPanel");
      document.getElementById("medalInner").innerHTML = medal;
      panel.style.display="block";
      setTimeout(function(){
        panel.style.display="none";
      },6000);
    }
  }
  window.onload = function(){loadLives(); checkMedal(); showPoem();};
})();
