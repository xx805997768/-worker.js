const STORAGE_KEY = "my_lives_v2";
const DEFAULT_LIVES = [
  {name:"小虎电竞（斗鱼）", url:"https://www.douyu.com/123456"},
  {name:"梦幻解说（虎牙）", url:"https://www.huya.com/77777"},
